digraph ER {
  graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=16, label="Личные и групповые диалоги", labelloc=t, nodesep=0.35, ranksep=0.75, splines=polyline];
  node [shape=plain, fontname="Arial", fontsize=12];
  edge [fontname="Arial", fontsize=12, color="#36566f", arrowsize=0.7];
  "conversation_attachments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e9f1f7"><B>conversation_attachments</B></TD></TR><TR><TD ALIGN="LEFT">PK: id</TD></TR><TR><TD ALIGN="LEFT">FK: conversation_id</TD></TR><TR><TD ALIGN="LEFT">FK: message_id</TD></TR><TR><TD ALIGN="LEFT">FK: owner_user_id</TD></TR><TR><TD ALIGN="LEFT">18 полей</TD></TR></TABLE>>];
  "conversation_avatar_objects" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e9f1f7"><B>conversation_avatar_objects</B></TD></TR><TR><TD ALIGN="LEFT">PK: id</TD></TR><TR><TD ALIGN="LEFT">FK: conversation_id</TD></TR><TR><TD ALIGN="LEFT">11 полей</TD></TR></TABLE>>];
  "conversation_members" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e9f1f7"><B>conversation_members</B></TD></TR><TR><TD ALIGN="LEFT">PK: conversation_id, user_id</TD></TR><TR><TD ALIGN="LEFT">FK: last_read_message_id</TD></TR><TR><TD ALIGN="LEFT">FK: last_read_sequence</TD></TR><TR><TD ALIGN="LEFT">11 полей</TD></TR></TABLE>>];
  "conversation_message_pins" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e9f1f7"><B>conversation_message_pins</B></TD></TR><TR><TD ALIGN="LEFT">PK: conversation_id, message_id</TD></TR><TR><TD ALIGN="LEFT">FK: pinned_by_user_id</TD></TR><TR><TD ALIGN="LEFT">4 полей</TD></TR></TABLE>>];
  "conversation_messages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e9f1f7"><B>conversation_messages</B></TD></TR><TR><TD ALIGN="LEFT">PK: id</TD></TR><TR><TD ALIGN="LEFT">FK: call_id</TD></TR><TR><TD ALIGN="LEFT">FK: conversation_id</TD></TR><TR><TD ALIGN="LEFT">FK: reply_to_id</TD></TR><TR><TD ALIGN="LEFT">FK: sender_user_id</TD></TR><TR><TD ALIGN="LEFT">14 полей</TD></TR></TABLE>>];
  "conversations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e9f1f7"><B>conversations</B></TD></TR><TR><TD ALIGN="LEFT">PK: id</TD></TR><TR><TD ALIGN="LEFT">FK: created_by</TD></TR><TR><TD ALIGN="LEFT">FK: last_message_id</TD></TR><TR><TD ALIGN="LEFT">FK: user_high_id</TD></TR><TR><TD ALIGN="LEFT">FK: user_low_id</TD></TR><TR><TD ALIGN="LEFT">17 полей</TD></TR></TABLE>>];
  "direct_calls" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f2f2f2"><B>direct_calls</B></TD></TR><TR><TD ALIGN="LEFT">PK: id</TD></TR></TABLE>>];
  "users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f2f2f2"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">PK: id</TD></TR></TABLE>>];
  "conversation_attachments" -> "conversations" [label="conversation_id → id\nDELETE RESTRICT"];
  "conversation_attachments" -> "conversation_messages" [label="conversation_id, message_id → conversation_id, id\nDELETE RESTRICT"];
  "conversation_attachments" -> "conversation_members" [label="conversation_id, owner_user_id → conversation_id, user_id\nDELETE RESTRICT"];
  "conversation_avatar_objects" -> "conversations" [label="conversation_id → id\nDELETE RESTRICT"];
  "conversation_members" -> "conversations" [label="conversation_id → id\nDELETE RESTRICT"];
  "conversation_members" -> "conversation_messages" [label="conversation_id, last_read_message_id, last_read_sequence → conversation_id, id, sequence\nDELETE RESTRICT"];
  "conversation_members" -> "users" [label="user_id → id\nDELETE RESTRICT"];
  "conversation_message_pins" -> "conversation_messages" [label="conversation_id, message_id → conversation_id, id\nDELETE CASCADE"];
  "conversation_message_pins" -> "conversation_members" [label="conversation_id, pinned_by_user_id → conversation_id, user_id\nDELETE RESTRICT"];
  "conversation_messages" -> "direct_calls" [label="call_id → id\nDELETE RESTRICT"];
  "conversation_messages" -> "conversations" [label="conversation_id → id\nDELETE RESTRICT"];
  "conversation_messages" -> "conversation_messages" [label="conversation_id, reply_to_id → conversation_id, id\nDELETE RESTRICT"];
  "conversation_messages" -> "conversation_members" [label="conversation_id, sender_user_id → conversation_id, user_id\nDELETE RESTRICT"];
  "conversations" -> "conversation_messages" [label="id, last_message_id → conversation_id, id\nDELETE RESTRICT"];
  "conversations" -> "users" [label="created_by → id\nDELETE RESTRICT"];
  "conversations" -> "users" [label="user_high_id → id\nDELETE RESTRICT"];
  "conversations" -> "users" [label="user_low_id → id\nDELETE RESTRICT"];
  "conversations" -> "conversation_avatar_objects" [style=dashed, color="#a06b20", label="avatar_version → id\nбез FK"];
}
