"users" [label="users", tooltip="users", fillcolor="#f2f2f2", color="#a4a9ad"];
"notification_jobs" -> "conference_participants" [tooltip="notification_jobs_participant_id_fkey: FOREIGN KEY (participant_id) REFERENCES conference_participants(id) ON DELETE RESTRICT"];
