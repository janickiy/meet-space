"notification_preferences" -> "users" [tooltip="notification_preferences_user_id_fkey: FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE RESTRICT"];
"notifications" -> "users" [tooltip="notifications_user_id_fkey: FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE RESTRICT"];
"background_jobs" -> "conferences" [style=dashed, color="#94661d", penwidth=1.45, tooltip="conference_id -> id; FK намеренно отсутствует для сохранения порядка блокировок.", constraint=false];
"background_jobs" -> "users" [style=dashed, color="#94661d", penwidth=1.45, tooltip="user_id -> id; Получатель по виду задания; FK отсутствует.", constraint=false];
"notification_jobs" -> "conferences" [style=dashed, color="#94661d", penwidth=1.45, tooltip="conference_id -> id; Прямой FK удалён/не создаётся; другие FK защищают связанные события.", constraint=false];
"notification_jobs" -> "conference_participants" [style=dashed, color="#94661d", penwidth=1.45, tooltip="cursor_participant_id -> id; Курсор рассылки; FK отсутствует.", constraint=false];
}
