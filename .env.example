APP_ENV=local
APP_PORT=8085
APP_HOST_PORT=8085
HTTPS_HOST_PORT=18482
FRONTEND_HOST_PORT=5173
GIN_MODE=debug
# Требуется только API: не менее 32 случайных байтов; secrets по умолчанию отсутствует.
# Генерация: openssl rand -hex 32
JWT_SECRET=
# Пустое значение запрещает доверять заголовкам с IP клиента от прокси. Укажите только реальные CIDR/IP прокси.
HTTP_TRUSTED_PROXIES=
DLV_API_PORT=2345
DLV_WORKER_PORT=2346
WORKER_ID=record-worker-local
WORKER_PORT=8090
WORKER_HOST_PORT=8090
STORAGE_PATH=/storage
FFMPEG_PATH=ffmpeg

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DB=go_recorder
POSTGRES_USER=go_recorder
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
RECORD_LOCK_TTL=6h

# Этап 2: единое пространство имён для всех экземпляров API, использующих эту базу PostgreSQL.
WS_REDIS_NAMESPACE=go-recorder:realtime:v1
WS_PING_INTERVAL=1s
WS_PONG_TIMEOUT=4s
WS_WRITE_TIMEOUT=5s
WS_SESSION_TTL=5s
WS_TICKET_TTL=45s
WS_QUEUE_SIZE=64
WS_MAX_MESSAGE_BYTES=270336
WS_MAX_OUTBOUND_BYTES=1048576
WS_MAX_SDP_BYTES=131072
WS_MAX_ICE_BYTES=4096
WS_MESSAGES_PER_SECOND=20
WS_MESSAGE_BURST=40
# Пустое значение требует точного совпадения хоста и порта с HTTP-запросом WebSocket.
WS_ALLOWED_ORIGINS=
# Конфигурация авторизованного браузера; встроенные публичные STUN и production-секрет TURN отсутствуют.
WEBRTC_ICE_SERVERS_JSON=[]

# Этап 3: SFU работает независимо от record-worker. Для промышленной эксплуатации создайте отдельные ключи.
# Только локально: пустые ключи заменяются производными JWT_SECRET с разделением по назначению.
MEDIA_TICKET_SECRET=
MEDIA_INTERNAL_SECRET=
MEDIA_HTTP_PORT=8091
MEDIA_WORKER_ID=media-worker-local
MEDIA_WORKER_INTERNAL_URL=http://media-worker:8091
MEDIA_REDIS_NAMESPACE=go-recorder:media:v1
MEDIA_TICKET_TTL=45s
MEDIA_OPERATION_TIMEOUT=5s
MEDIA_HEARTBEAT_INTERVAL=5s
MEDIA_WORKER_TTL=15s
MEDIA_OWNERSHIP_TTL=20s
MEDIA_SESSION_CHECK_INTERVAL=5s
MEDIA_MAX_PEERS=10
MEDIA_MAX_ROOMS=100
MEDIA_MAX_PUBLISHED_TRACKS=4
MEDIA_MAX_AUDIO_TRACKS=2
MEDIA_MAX_VIDEO_TRACKS=2
MEDIA_MAX_SCREEN_SHARERS=1
MEDIA_EGRESS_QUEUE_SIZE=2048
MEDIA_VIDEO_MAX_WIDTH=1280
MEDIA_VIDEO_MAX_HEIGHT=720
MEDIA_VIDEO_MAX_FPS=30
# Используйте UDP-мультиплексор или отдельный диапазон портов. Compose по умолчанию использует мультиплексор.
MEDIA_UDP_PORT=50010
MEDIA_UDP_MIN_PORT=0
MEDIA_UDP_MAX_PORT=0
MEDIA_TCP_PORT=50010
# Для Firefox и Docker Desktop укажите IP компьютера в локальной сети; на сервере — доступный публичный IP.
MEDIA_NAT_IPS=127.0.0.1
MEDIA_ICE_SERVERS_JSON=[]
MEDIA_ICE_DISCONNECTED_TIMEOUT=10s
MEDIA_ICE_FAILED_TIMEOUT=20s
MEDIA_ICE_KEEPALIVE_INTERVAL=2s
MEDIA_NEGOTIATION_TIMEOUT=10s

# Этап 4: FFmpeg запускается только в record-worker; ограничения действуют для каждого воркера.
RECORDING_WIDTH=1280
RECORDING_HEIGHT=720
RECORDING_FPS=30
RECORDING_FFMPEG_CONCURRENCY=1
RECORDING_MAX_ACTIVE=2
# Предел принятого RTP на одну запись, а не квота файловой системы для временных файлов и композиции.
RECORDING_MAX_MIB=10240
RECORDING_LEASE_TTL=20s
RECORDING_POLL_INTERVAL=1s
RECORDING_MAX_DURATION=4h
# После фиксации приватных артефактов в MinIO временные файлы успешной записи удаляются.
RECORDING_KEEP_LOCAL=false

RABBIT_MQ_USER=go_recorder
RABBIT_MQ_PASSWORD=
RABBIT_MQ_HOST=rabbitmq
RABBIT_MQ_PORT=5672
RABBIT_MQ_HOST_PORT=5672
RABBIT_MQ_MANAGEMENT_HOST_PORT=15672
RABBIT_MQ_VHOST=/
RABBIT_MQ_EXCHANGE=go-recorder.commands
RABBIT_MQ_QUEUE=go-recorder.recording.commands
RABBIT_MQ_ROUTING_KEY=record.commands

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_DEFAULT_RPM=240
RATE_LIMIT_AUTH_LOGIN_IP_RPM=10
RATE_LIMIT_AUTH_REGISTER_IP_RPM=5

MINIO_ROOT_USER=go_recorder
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://localhost:18482
MINIO_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001
MINIO_BUCKET=recordings
MINIO_USE_SSL=false

# Этап 6: эксплуатация. Пустые secrets требуется заполнить перед запуском prod.
METRICS_SECRET=
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL=10m
TURN_FORCE_RELAY=false
WS_MAX_CONNECTIONS=1000
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_TIMEOUT=60s
HEALTH_PROBE_INTERVAL=2s
HEALTH_PROBE_TIMEOUT=1s
SHUTDOWN_TIMEOUT=20s
DB_MAX_OPEN=20
DB_MAX_IDLE=10
DB_CONNECTION_LIFETIME=30m
DB_QUERY_TIMEOUT=10s

# Этап 7: отдельный product-worker. Данные не отправляются внешним сервисам по умолчанию.
PUBLIC_FRONTEND_URL=https://localhost:18482
PRODUCT_WORKER_PORT=8092
PRODUCT_POLL_INTERVAL=5s
PROVIDER_TIMEOUT=15s
EMAIL_PROVIDER_MODE=noop
EMAIL_PROVIDER_ENDPOINT=
EMAIL_PROVIDER_TOKEN=
# Для прямой доставки: EMAIL_PROVIDER_MODE=smtp. tls — implicit TLS, starttls — обязательный STARTTLS.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Meetrix <noreply@example.invalid>
SMTP_TIMEOUT=15s
PUSH_PROVIDER_MODE=noop
PUSH_PROVIDER_ENDPOINT=
PUSH_PROVIDER_TOKEN=
CALENDAR_PROVIDER_MODE=noop
CALENDAR_PROVIDER_ENDPOINT=
CALENDAR_PROVIDER_TOKEN=
# Независимый AES-256 ключ: openssl rand -base64 32. Не использовать JWT_SECRET.
PROVIDER_TOKEN_ENCRYPTION_KEY=
REMINDER_OFFSETS=3h
CALENDAR_OAUTH_AUTH_URL=
CALENDAR_OAUTH_TOKEN_URL=
CALENDAR_OAUTH_REVOKE_URL=
CALENDAR_OAUTH_CLIENT_ID=
CALENDAR_OAUTH_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_URL=
CALENDAR_OAUTH_SCOPES=
PRODUCT_DELIVERY_CONCURRENCY=2
PRODUCT_CALENDAR_CONCURRENCY=1
PRODUCT_MAX_ATTEMPTS=5
RECORDING_DISK_RESERVE_MIB=256
# Только loopback внутри контейнера; 0 отключает pprof.
PPROF_PORT=0
