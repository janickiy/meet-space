# Dedicated TLS origin; never include these routes in the public 443 server.
log_format admin_safe '$remote_addr $request_method $uri $status';
server {
    listen 8081 ssl;
    server_name _;
    ssl_certificate @@ADMIN_TLS_CERT@@;
    ssl_certificate_key @@ADMIN_TLS_KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /usr/share/nginx/admin;
    index index.html;
    client_max_body_size 1m;
    client_body_timeout 15s;
    access_log /var/log/nginx/access.log admin_safe;
    resolver 127.0.0.11 valid=5s ipv6=off;
    set $admin_upstream api:8082;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Cache-Control "no-store" always;

    location ^~ /api/v1/admin/ {
        error_log /dev/null crit;
        proxy_pass http://$admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }
    location /api/ { return 404; }
    location ~ ^/(metrics|health|internal|operations|debug)(/|$) { return 404; }
    location / { try_files $uri $uri/ /index.html; }
}
